diff --git a/domain/src/main/kotlin/com/yahpz/domain/AppUpdate.kt b/domain/src/main/kotlin/com/yahpz/domain/AppUpdate.kt
index 3e36fc1..fb47b8e 100644
--- a/domain/src/main/kotlin/com/yahpz/domain/AppUpdate.kt
+++ b/domain/src/main/kotlin/com/yahpz/domain/AppUpdate.kt
@@ -3,3 +3,59 @@ package com.yahpz.domain
 /** True when the installed build is below the server minimum (hard force update). */
 fun needsForceUpdate(currentVersionCode: Int, minVersionCode: Int): Boolean =
     currentVersionCode < minVersionCode
+
+/** How the app should react to the published version manifest. */
+enum class UpdateMode { None, Soft, Force }
+
+/**
+ * Force below the minimum, soft between the minimum and the latest published build.
+ * A latest lower than the minimum is treated as the minimum.
+ */
+fun decideUpdateMode(currentVersionCode: Int, minVersionCode: Int, latestVersionCode: Int): UpdateMode {
+    val latest = maxOf(latestVersionCode, minVersionCode)
+    return when {
+        currentVersionCode < minVersionCode -> UpdateMode.Force
+        currentVersionCode < latest -> UpdateMode.Soft
+        else -> UpdateMode.None
+    }
+}
+
+/** Hex digest compare for a downloaded APK. Blank expected never matches. */
+fun sha256Matches(expectedHex: String?, actualHex: String?): Boolean {
+    val expected = expectedHex?.trim()?.lowercase().orEmpty()
+    val actual = actualHex?.trim()?.lowercase().orEmpty()
+    if (expected.isEmpty() || actual.isEmpty()) return false
+    return expected == actual
+}
+
+/** Null when the total size is unknown, so the UI can fall back to an indeterminate bar. */
+fun downloadProgressFraction(downloadedBytes: Long, totalBytes: Long): Float? {
+    if (totalBytes <= 0L || downloadedBytes < 0L) return null
+    return (downloadedBytes.toDouble() / totalBytes.toDouble()).coerceIn(0.0, 1.0).toFloat()
+}
+
+/** `12.3 מ״ב מתוך 18.4 מ״ב`, or just the downloaded part when the total is unknown. */
+fun formatDownloadProgressHe(downloadedBytes: Long, totalBytes: Long): String {
+    val done = formatMegabytesHe(downloadedBytes)
+    if (totalBytes <= 0L) return done
+    return "$done מתוך ${formatMegabytesHe(totalBytes)}"
+}
+
+private fun formatMegabytesHe(bytes: Long): String {
+    val mb = bytes.coerceAtLeast(0L).toDouble() / (1024.0 * 1024.0)
+    val rounded = kotlin.math.round(mb * 10.0) / 10.0
+    val whole = rounded.toLong()
+    val tenth = kotlin.math.round((rounded - whole) * 10.0).toLong()
+    return "$whole.$tenth מ״ב"
+}
+
+/**
+ * In-app install needs a checksum to verify the download. Without one the app
+ * falls back to opening the APK URL in a browser.
+ */
+fun canInstallInApp(apkUrl: String?, apkSha256: String?): Boolean {
+    val url = apkUrl?.trim().orEmpty()
+    if (!url.startsWith("https://")) return false
+    if (!url.endsWith(".apk")) return false
+    return apkSha256?.trim()?.length == 64 && apkSha256.trim().all { it.isDigit() || it.lowercaseChar() in 'a'..'f' }
+}
