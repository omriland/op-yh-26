+    /**
+     * Downloads the published APK, verifies it, and opens the system install sheet.
+     * Sideloaded apps cannot install silently — the user still confirms once.
+     */
+    fun startAppUpdate(context: Context) {
+        val update = _state.value.appUpdate ?: return
+        if (!update.canInstallInApp) return
+        if (updateJob?.isActive == true) return
+        if (!ApkUpdate.canInstallPackages(context)) {
+            _state.update {
+                it.copy(updateStage = UpdateStage.NEEDS_PERMISSION, updateErrorHe = null)
+            }
+            return
+        }
+        updateJob = viewModelScope.launch {
+            _state.update {
+                it.copy(
+                    updateStage = UpdateStage.DOWNLOADING,
+                    updateDownloadedBytes = 0L,
+                    updateTotalBytes = update.apkSizeBytes,
+                    updateErrorHe = null,
+                )
+            }
+            val downloaded = ApkUpdate.download(
+                context = context,
+                apkUrl = update.apkUrl,
+                expectedSha256 = update.apkSha256,
+                expectedSizeBytes = update.apkSizeBytes,
+                onProgress = { done, total ->
+                    _state.update { it.copy(updateDownloadedBytes = done, updateTotalBytes = total) }
+                },
+                onVerifying = {
+                    _state.update { it.copy(updateStage = UpdateStage.VERIFYING) }
+                },
+            )
+            val apk = downloaded.getOrElse { error ->
+                if (error is CancellationException) throw error
+                _state.update {
+                    it.copy(
+                        updateStage = UpdateStage.IDLE,
+                        updateErrorHe = downloadFailureMessage(error),
+                    )
+                }
+                return@launch
+            }
+            _state.update { it.copy(updateStage = UpdateStage.INSTALLING) }
+            ApkUpdate.install(context, apk).onFailure {
+                _state.update {
+                    it.copy(updateStage = UpdateStage.IDLE, updateErrorHe = UPDATE_INSTALL_FAILED_MESSAGE)
+                }
+            }
+        }
+    }
+
+    fun cancelAppUpdate() {
+        updateJob?.cancel()
+        updateJob = null
+        _state.update {
+            it.copy(updateStage = UpdateStage.IDLE, updateDownloadedBytes = 0L, updateErrorHe = null)
+        }
+    }
+
